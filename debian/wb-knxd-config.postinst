#!/bin/bash
set -e

usermod -a -G dialout knxd >/dev/null

# Force-restart wb-knxd-config if upgrading from old versions.
#
# Before 1.0.3 service did not start on installation.
# In 1.0.3 DEBHELPER placeholder was added, but service was without 'RemainAfterExit',
# so 'try-restart' from dh_systemd doesn't actually restart service.
#
# This was fixed in 1.1.0 by adding 'RemainAfterExit'.
if [[ "$1" == "configure" ]] && dpkg --compare-versions "$2" lt "1.1.0~~"; then
    deb-systemd-invoke restart wb-knxd-config.service >/dev/null || true
fi

# Apply the knxd.socket drop-in (knxd protocol on /var/run/knx and 127.0.0.1:6720
# only, see /usr/lib/systemd/system/knxd.socket.d/wb-knxd-config.conf).
# A socket unit can't change its listeners while knxd holds them, so stop
# both, then start the socket again.
if [[ "$1" == "configure" ]] && dpkg --compare-versions "$2" lt "1.2.0~~" &&
    [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
    if systemctl is-active --quiet knxd.socket; then
        knxd_was_active=0
        systemctl is-active --quiet knxd.service && knxd_was_active=1
        deb-systemd-invoke stop knxd.service knxd.socket >/dev/null || true
        deb-systemd-invoke start knxd.socket >/dev/null || true
        if [[ "$knxd_was_active" == 1 ]] &&
            ! systemctl is-active --quiet wb-knxd-config.service; then
            deb-systemd-invoke start knxd.service >/dev/null || true
        fi
    fi
fi

#DEBHELPER#
